# Enterprise Ops Agent — Environment Variables
# Copy to .env and fill in your values. NEVER commit .env to git.

# ── AWS ──────────────────────────────────────────────────────────────────────
AWS_DEFAULT_REGION=us-east-1
# Leave blank to use instance profile / IAM role (recommended for production)
AWS_PROFILE=
# AWS_ACCESS_KEY_ID=          # Only for local dev; use instance profiles in prod
# AWS_SECRET_ACCESS_KEY=      # Only for local dev; use instance profiles in prod

# ── TrueForge ────────────────────────────────────────────────────────────────
TRUEFORGE_URL=http://localhost:3000

# ── Agent RBAC ───────────────────────────────────────────────────────────────
# viewer = read-only discovery only
# operator = read + approve deletions
# admin = full access including batch operations
AGENT_CALLER_ROLE=viewer

# ── Cloud Cost Janitor ────────────────────────────────────────────────────────
JANITOR_DB_PATH=/tmp/janitor_sessions.db

# ── Migration Rehearsal ───────────────────────────────────────────────────────
DATABASE_SANDBOX_PATH=/tmp/migration_sandbox.db

# ── GitHub / Release Captain ──────────────────────────────────────────────────
# Required for release-captain subagent
GITHUB_TOKEN=

# ── Ticket Resolver ───────────────────────────────────────────────────────────
# Required for ticket-resolver subagent
LINEAR_API_KEY=
