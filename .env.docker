# Docker runtime secrets — copy this file and fill in real values.
# Never commit a filled-in version to git.

# GitHub token for release-captain (read:repo + read:packages minimum)
GITHUB_TOKEN=

# Linear API key for ticket-resolver (optional — mock data used if blank)
LINEAR_API_KEY=

# AWS region override (default: us-east-1)
# AWS_DEFAULT_REGION=us-east-1

# Caller role for RBAC checks: viewer | operator | admin | sre
# AGENT_CALLER_ROLE=viewer
